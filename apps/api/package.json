{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "generate": "node scripts/ensure-openapi.mjs",
    "dump-openapi": "tsx --tsconfig tsconfig.json scripts/dump-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "12.1.3",
    "@nestjs/cqrs": "12.1.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/typeorm": "12.0.2",
    "@repo/contracts": "workspace:*",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "zod": "4.6.7",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
