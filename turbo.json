{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "boundaries": {
    "tags": {
      "app": {
        "dependents": {
          "deny": [
            "app",
            "package"
          ]
        }
      },
      "package": {
        "dependencies": {
          "allow": [
            "package"
          ]
        }
      }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "HOST",
        "DATABASE_URL",
        "API_URL",
        "SCORING_URL"
      ]
    }
  }
}
