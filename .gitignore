# Единый .gitignore на весь монорепозиторий.
# Lock-файлы (pnpm-lock.yaml, apps/scoring/uv.lock) НЕ игнорируются: их коммитим.

# Dependencies
node_modules
.pnp
.pnp.js

# Env: секреты не коммитим, шаблоны .env.example коммитим
.env
.env.*
!.env.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Python
.venv
__pycache__/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
