{
  "name": "smart-credit-dashboard-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "rspress dev --host 127.0.0.1",
    "build": "npm run diagrams:check:artifacts && rspress build",
    "diagrams:build": "node scripts/build-diagrams.mjs",
    "diagrams:check": "node scripts/check-diagrams.mjs",
    "diagrams:check:artifacts": "node scripts/check-diagram-artifacts.mjs",
    "preview": "rspress preview --host 127.0.0.1 --port 4173"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@rspress/core": "2.0.23"
  }
}
