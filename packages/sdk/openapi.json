                    "pending",
                    "confirmed",
                    "discrepancy",
                    "unavailable",
                    "manual_check"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "facts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string",
                        "enum": [
                          "egrul",
                          "fns",
                          "bki",
                          "bank_turnover"
                        ]
                      },
                      "state": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "confirmed",
                          "discrepancy",
                          "unavailable",
                          "manual_check"
                        ]
                      },
                      "checkedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "label",
                      "value",
                      "source",
                      "state",
                      "checkedAt"
                    ]
                  }
                },
                "discrepancies": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "firstValue": {
                        "type": "string"
                      },
                      "secondValue": {
                        "type": "string"
                      },
                      "firstSource": {
                        "type": "string",
                        "enum": [
                          "egrul",
                          "fns",
                          "bki",
                          "bank_turnover"
                        ]
                      },
                      "secondSource": {
                        "type": "string",
                        "enum": [
                          "egrul",
                          "fns",
                          "bki",
                          "bank_turnover"
                        ]
                      },
                      "nextStep": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "key",
                      "label",
                      "firstValue",
                      "secondValue",
                      "firstSource",
                      "secondSource",
                      "nextStep"
                    ]
                  }
                },
                "action": {
                  "default": "none",
                  "type": "string",
                  "enum": [
                    "none",
                    "grant_bki_consent",
                    "retry_source",
                    "manual_review"
                  ]
                },
                "reason": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "checkedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "source",
                "state",
                "summary",
                "facts",
                "checkedAt"
              ]
            }
          },
          "bkiConsent": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "required",
                  "granted"
                ]
              },
              "grantedAt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "status",
              "grantedAt"
            ]
          }
        },
        "required": [
          "profile",
          "sources",
          "bkiConsent"
        ]
      },
