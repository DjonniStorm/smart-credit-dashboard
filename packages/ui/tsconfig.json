{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    // JIT-пакет: потребители берут src/*.tsx напрямую, сборки нет.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strictNullChecks": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
