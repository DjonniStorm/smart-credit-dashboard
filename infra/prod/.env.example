# Скопируйте в infra/prod/.env (он в .gitignore) и поменяйте секреты.
POSTGRES_USER=alfa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alfa
GRAFANA_ADMIN_PASSWORD=

# Публичные домены: клиент http://localhost, бэк-офис http://backoffice.localhost,
# прямой доступ к API http://api.localhost. Схему подбирает Caddy сам, SCHEME
# оставлен для совместимости и в Caddyfile не используется.
DOMAIN=localhost
BACKOFFICE_DOMAIN=backoffice.localhost
API_DOMAIN=api.localhost
SCHEME=http
HTTP_PORT=80
HTTPS_PORT=443
