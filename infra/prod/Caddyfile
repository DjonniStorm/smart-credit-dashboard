# По умолчанию http://localhost. Для публичного домена: DOMAIN=example.ru, SCHEME=https
# (Caddy сам получит сертификат Let's Encrypt).

{$SCHEME}://{$DOMAIN} {
	reverse_proxy client:3000
}

{$SCHEME}://backoffice.{$DOMAIN} {
	reverse_proxy backoffice:3001
}

# Swagger UI: /docs
{$SCHEME}://api.{$DOMAIN} {
	reverse_proxy api:4000
}
