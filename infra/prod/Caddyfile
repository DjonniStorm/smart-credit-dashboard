{$DOMAIN} {
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy client:3000
	}
}

{$BACKOFFICE_DOMAIN} {
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy backoffice:3001
	}
}

{$API_DOMAIN} {
	handle /metrics {
		respond 404
	}
	handle {
		reverse_proxy api:4000
	}
}