{
  "name": "smart-credit-dashboard",
  "private": true,
  "scripts": {
    "dev": "pnpm db:up && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "boundaries": "turbo boundaries",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:up": "docker compose -f infra/dev/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/dev/docker-compose.yml down",
    "docker:up": "docker compose -f infra/prod/docker-compose.yml up --build -d --wait",
    "docker:down": "docker compose -f infra/prod/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
